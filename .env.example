# Copy to .env for local/Docker deployment
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=production

# Sprint 6 cloud storage
# Keep local while testing without S3. Set to s3 after configuring the EC2 IAM role and bucket.
STORAGE_MODE=local
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=cloudstream/
